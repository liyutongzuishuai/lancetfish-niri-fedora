{
  // 电池电量
  "battery": {
    "interval": 60,
    "states": {
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}% ",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "剩余电量：{capacity}%\n充 放 电 ：{power}\n可用时间：{timeTo}\n---\n电池健康度：{health}%"
  },
  // 时钟
  "clock": {
    "interval": 60,
    "format": "󰥔 {:%H:%M}",
    "tooltip-format": "{:%Y/%m/%d %A}\n---\n左键：打开时钟\n右键：打开日历",
    "max-length": 25,
    "on-click": "gnome-clocks",
    "on-click-right": "gnome-calendar"
  },
  "clock#date": {
    "format": "󰸗 {:%m-%d}",
    "on-click": "gnome-calendar",
    "tooltip-format": "{:%Y/%m/%d %A}"
  },
  // 托盘
  "tray": {
    "icon-size": 22,
    "spacing": 7
  },
  // Niri 工作区和窗口名称
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰜋",
      "default": ""
    }
  },
  "niri/window": {
    "format": "{}",
    "rewrite": {
      "(.*) — Mozilla Firefox": "🌎 $1",
      "(.*) - Mozilla Firefox": "🌎 $1",
      "(.*) - fish": "> [$1]",
      "(.*) - bash": "> [$1]"
    }
  },
  // 网络与蓝牙组
  "group/network-bluetooth": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "network",
      "bluetooth"
    ]
  },
  "network": {
    "format-disconnected": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-icons": {
      "disconnected": "󰤮",
      "wifi": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": "󰈀"
    },
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\n左键：打开网络配置",
    "tooltip-format-ethernet": "{ifname} : {ipaddr}\n---\n左键：打开网络配置",
    "tooltip-format-disconnected": "网络未连接",
    "on-click": "nm-connection-editor",
    "on-click-right": "nm-connection-editor"
  },
  "bluetooth": {
    "format-disabled": "󰂲",
    "tooltip-format-disabled": "右键：启用蓝牙",
    "format": "󰂯",
    "tooltip-format-on": "左键：打开蓝牙控制\n右键：禁用蓝牙",
    "format-connected": "󰂱",
    "tooltip-format-connected": "󰂱 {device_alias}\n---\n左键：打开蓝牙控制",
    "on-click": "blueman-manager || kitty --class bluetui -e bluetui",
    "on-click-right": "rfkill toggle bluetooth"
  },
  // 性能模式
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "当前性能模式：{profile}\n---\n左键：切换性能模式",
    "tooltip": true,
    "format-icons": {
      "performance": "󱐋",
      "balanced": "",
      "power-saver": ""
    }
  },
  // 截图
  "custom/screenshot": {
    "format": "",
    "tooltip-format": "左键：区域截图存入剪贴板",
    "on-click": "grim -g \"$(slurp)\" - | wl-copy"
  },
  // 音频组
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "pulseaudio": {
    "tooltip-format": "左键：静音/取消静音\n右键：切换麦克风静音\n中键：打开调音台",
    "format": "{icon} {format_source}",
    "format-bluetooth": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-muted": " {format_source}",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "bluetooth": "",
      "speaker": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  // 多媒体播放器控制
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "▶"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "tooltip-format": "{dynamic}",
    "enable-tooltip-len-limits": true
  },
  // 应用程序启动器
  "custom/applauncher": {
    "tooltip-format": "左键：软件菜单\n右键：打开终端",
    "format": "",
    "on-click": "fuzzel",
    "on-click-right": "ptyxis || ghostty || kitty || foot || alacritty"
  },
  // 电源菜单
  "group/powermenu": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "custom/wlogout",
      "custom/reboot",
      "custom/logout",
      "custom/lockscreen"
    ]
  },
  "custom/wlogout": {
    "tooltip-format": "左键：关机",
    "format": "󰐥",
    "on-click": "choice=$(echo -e '否\\n是' | fuzzel --dmenu --prompt '确定要关机吗？ ' --lines 2); [ \"$choice\" = '是' ] && systemctl poweroff"
  },
  "custom/lockscreen": {
    "tooltip-format": "左键：锁屏",
    "format": "",
    "on-click": "swaylock || hyprlock"
  },
  "custom/reboot": {
    "tooltip-format": "左键：重启",
    "format": "",
    "on-click": "choice=$(echo -e '否\\n是' | fuzzel --dmenu --prompt '确定要重启吗？ ' --lines 2); [ \"$choice\" = '是' ] && systemctl reboot"
  },
  "custom/logout": {
    "tooltip-format": "左键：注销",
    "format": "󰈆",
    "on-click": "niri msg action quit"
  },
  // 屏幕亮度
  "backlight": {
    "tooltip": true,
    "tooltip-format": "亮度：{percent}%",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal"
  },
  "group/backlight": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "backlight",
      "backlight/slider"
    ]
  },
  // 通知中心 (swaync)
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  // 防休眠
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "start-activated": false,
    "tooltip-format-activated": "自动熄屏已禁止",
    "tooltip-format-deactivated": "自动熄屏已开启"
  },
  // 分隔符
  "custom/separator#1": {
    "format": "󱋱",
    "tooltip": false
  },
  // Fedora DNF 软件更新检测
  "custom/updates": {
    "format": "{icon} {}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "",
      "updated": ""
    },
    "exec": "dnf check-update --quiet | wc -l | awk '{if ($1 > 0) print \"{\\\"text\\\": \\\"\" $1 \"\\\", \\\"class\\\": \\\"has-updates\\\"}\"; else print \"{\\\"text\\\": \\\"\\\", \\\"class\\\": \\\"updated\\\"}\"}'",
    "interval": 3600,
    "on-click": "ptyxis -e sudo dnf upgrade || kitty -e sudo dnf upgrade",
    "tooltip-format": "左键：升级系统软件包"
  },
  // 剪贴板
  "custom/clipboard": {
    "format": "󰅍",
    "on-click": "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy",
    "on-click-right": "cliphist wipe",
    "tooltip-format": "左键：选择剪贴板历史\n右键：清空剪贴板"
  },
  // 壁纸切换
  "custom/wallpapers": {
    "format": "󰸉",
    "tooltip-format": "左键：打开壁纸选择器\n右键：随机切换壁纸",
    "on-click": "waypaper",
    "on-click-right": "waypaper --random"
  },
  "custom/watch": {
     "exec": "~/.config/waybar/scripts/watch.sh",
     "interval": 60
  }
}
