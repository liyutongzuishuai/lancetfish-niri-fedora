{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 4,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "custom/distro",
        "niri/workspaces",
        "custom/separator",
        "niri/window"
    ],

    "modules-center": [
        "clock",
        "custom/clipboard"
    ],

    "modules-right": [
        "pulseaudio",
        "custom/separator",
        "network",
        "custom/separator",
        "bluetooth",
        "custom/separator",
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "temperature",
        "custom/separator",
        "battery",
        "tray"
    ],

    "custom/separator": {
        "format": "·",
        "tooltip": false
    },

    "custom/distro": {
        "format": "󰣛",
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰜋",
            "default": ""
        },
        "on-click": "activate"
    },

    "niri/window": {
        "format": "{}",
        "max-length": 35,
        "tooltip": false,
        "rewrite": {
            "(.*) — Mozilla Firefox": "🌎 $1",
            "(.*) - Mozilla Firefox": "🌎 $1",
            "(.*) - fish": "> [$1]",
            "(.*) - bash": "> [$1]"
        }
    },

    "custom/clipboard": {
        "format": "󰅇",
        "tooltip": false,
        "on-click": "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy",
        "on-click-right": "cliphist wipe"
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "{:%Y/%m/%d %A}",
        "max-length": 25,
        "on-click": "gnome-clocks",
        "on-click-right": "gnome-calendar"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip-format": "{desc} — {volume}%"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-disconnected": "󰤮",
        "format-icons": {
            "disconnected": "󰤮",
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": "󰈀"
        },
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}",
        "tooltip-format-ethernet": "{ifname} : {ipaddr}",
        "tooltip-format-disconnected": "网络未连接",
        "on-click": "nm-connection-editor",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format-disabled": "󰂲",
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "tooltip-format-disabled": "右键：启用蓝牙",
        "tooltip-format-on": "左键：打开蓝牙控制\n右键：禁用蓝牙",
        "tooltip-format-connected": "󰂱 {device_alias}",
        "on-click": "blueman-manager || kitty --class bluetui -e bluetui",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 3,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        "interval": 10,
        "critical-threshold": 85,
        "format-critical": "󰸁 {temperatureC}°",
        "format": "󰔏 {temperatureC}°"
    },

    "battery": {
        "interval": 60,
        "states": { "warning": 30, "critical": 20 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip-format": "剩余电量：{capacity}%\n充放电：{power}\n可用时间：{timeTo}\n---\n电池健康度：{health}%"
    },

    "tray": {
        "spacing": 5,
        "icon-size": 18
    }
}